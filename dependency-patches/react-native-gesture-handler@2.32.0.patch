   private class ScrollViewHook : NativeViewGestureHandlerHook {
+    private var dispatchingInterceptedStream = false
+
     override fun shouldCancelRootViewGestureHandlerIfNecessary() = true
+
+    override fun sendTouchEvent(view: View?, event: MotionEvent): Boolean? {
+      val terminal = event.actionMasked == MotionEvent.ACTION_UP || event.actionMasked == MotionEvent.ACTION_CANCEL
+      // Before activation, UP/CANCEL still belong to the normal root dispatch.
+      // Redispatching them here interrupts selectable text's native action mode.
+      if (!dispatchingInterceptedStream && terminal) return view?.onTouchEvent(event)
+
+      // Interception bypasses root dispatch. Let the ScrollView cancel its child
+      // touch target, or text can run a pending long-press after UP (Cindy #6219).
+      dispatchingInterceptedStream = true
+      val handled = view?.dispatchTouchEvent(event)
+      if (terminal) dispatchingInterceptedStream = false
+      return handled
+    }
   }
 
